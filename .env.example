WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"
NEXT_PUBLIC_WORDPRESS_URL="https://example.com"

# AI Content API: server-only secret. Use Authorization: Bearer <value>.
AI_CONTENT_API_SECRET="replace-with-a-long-random-secret"

# WordPress write credentials (server-only).
# Create a dedicated WordPress Application Password and never commit the real value.
WORDPRESS_API_URL="https://example.com"
WORDPRESS_API_USERNAME="wordpress-api-user"
WORDPRESS_API_APP_PASSWORD="replace-with-wordpress-application-password"

# Production AI storage
AI_STORAGE_BACKEND="supabase"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

# If using the revalidate plugin
# Generate a separate secret. Do not reuse AI_CONTENT_API_SECRET.
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"
